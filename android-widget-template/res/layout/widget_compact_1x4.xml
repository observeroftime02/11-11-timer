<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Bar Widget (2x1 or 4x1) - Sleek single-row launcher bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Golden 11:11 Chip -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_gold_chip"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:11"
            android:textColor="#0C0A09"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- City Info (Expanding) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/compact_widget_cities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gambier, Athens, Cairo"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/compact_widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="11:11 AM • Next worldwide"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Countdown Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_amber"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/compact_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="in 6 min"
            android:textColor="#FBBF24"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
