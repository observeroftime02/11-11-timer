<?xml version="1.0" encoding="utf-8"?>
<!-- Square / Dial Widget (2x2 or 3x3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT 11:11"
        android:textColor="#D97706"
        android:textStyle="bold"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

    <!-- Big 11:11 Display -->
    <TextView
        android:id="@+id/square_widget_time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:11"
        android:textColor="#FBBF24"
        android:textStyle="bold"
        android:textSize="32sp"
        android:layout_marginTop="2dp" />

    <!-- Countdown Badge -->
    <TextView
        android:id="@+id/square_widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge_amber"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="in 6 min"
        android:textColor="#FDE68A"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- Cities -->
    <TextView
        android:id="@+id/square_widget_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Marquesas, Tehran"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/square_widget_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:11 AM • UTC+3:30"
        android:textColor="#9CA3AF"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />
</LinearLayout>
